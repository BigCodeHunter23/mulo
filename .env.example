# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git, so real keys never reach the repo. On Vercel, set the same names under
# Project → Settings → Environment Variables instead.
#
# The site checks the three required settings when it starts and logs a plain
# message for any that are missing or malformed (src/lib/env.ts).

# --- Required ---------------------------------------------------------------

# Supabase → Project Settings → API. The URL and anon key are public by design:
# row-level security decides what they can read and write.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Server only: never prefix it NEXT_PUBLIC_,
# never paste it anywhere public. Used for catalogue writes and the scripts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ---------------------------------------------------------------

# Who can open the moderation inbox at /admin/reports, separated by commas.
# Unset means nobody can.
ADMIN_EMAILS=

# The public address used in share links and page metadata. On Vercel it
# follows the production domain by itself; locally it defaults to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Sign in with Apple's tokens (src/lib/apple.ts) ----------------------------
# Apple requires that deleting an account cancels its Sign in with Apple link.
# To do that the site keeps Apple's refresh token for each Apple account,
# sealed. While any of these is unset, signing in with Apple still works, but
# the tokens aren't kept or revoked (the logs say so). All server only: never
# prefix them NEXT_PUBLIC_.
#
# Apple Developer account → Membership details → Team ID.
APPLE_TEAM_ID=
# Apple Developer → Certificates, Identifiers & Profiles → Keys: a key with
# "Sign in with Apple" enabled. Its 10-character Key ID, and the contents of
# the .p8 file it downloads once (on one line, write each line break as \n).
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Identifiers → Services IDs: the website's Services ID (used for sign-ins in
# the browser), and the app's bundle id (Identifiers → App IDs).
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=com.mulo.app
# Seals the stored tokens: 32 random bytes in base64, made once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes the tokens already kept unusable.
APPLE_TOKEN_KEY=

# --- Browser tests only (npm run test:e2e) -----------------------------------
# The signed-in tests need a NON-PRODUCTION Supabase project and a confirmed
# test account there. Without these they skip.
E2E_EMAIL=
E2E_PASSWORD=
E2E_USERNAME=
E2E_ALBUM_MBID=
# Optional: lets the sign-up test create throwaway accounts at <random>@<domain>.
E2E_SIGNUP_DOMAIN=
